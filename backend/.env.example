# --- Auth ---
JWT_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=          # argon2/bcrypt hash, asla duz metin
ACCESS_TOKEN_TTL_MIN=60

# --- ESP32 ingestion ---
ESP32_API_KEY=                # X-API-Key header'inda beklenen deger
INGEST_BIND_HOST=0.0.0.0      # LAN-only; tunnel'a acilmaz

# --- WOL / hedef PC ---
PC_MAC=
PC_IP=
PC_BROADCAST=
PC_AGENT_URL=                 # sleep komutu icin PC ajani
PC_AGENT_TOKEN=

# --- DB ---
DATABASE_URL=sqlite:///./data/presence.db

# --- Davranis ---
ABSENCE_DEBOUNCE_MIN=10
AUTO_SLEEP_ENABLED=false      # opt-in, varsayilan kapali
AUTO_SLEEP_AFTER_MIN=30

# --- Rate limit ---
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_PRESENCE=30/minute

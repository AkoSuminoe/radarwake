# backend/.env olarak kopyala. Degerleri uretmek icin:
#   python scripts/hash_password.py

# --- Auth ---
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=          # argon2 hash, tek tirnak icinde; asla duz metin
ACCESS_TOKEN_TTL_MIN=10080         # 7 gun (telefonda sik giris istemesin)
COOKIE_SECURE=false           # LAN'da duz HTTP; HTTPS kullanilirsa true

# --- Portlar (container ici) ---
API_PORT=8000                 # dashboard (telefon: http://192.168.1.146:8000)
INGEST_PORT=8001              # ESP32 + pc-agent
# Sadece bu adreslerle gelen istekler kabul edilir (DNS rebinding korumasi)
ALLOWED_HOSTS=192.168.1.146,localhost,127.0.0.1

# --- ESP32 ---
ESP32_API_KEY=                # firmware config.h API_KEY ile ayni
POWER_COMMAND_TTL_S=60        # ESP bu surede komutu almazsa iptal

# --- PC ajani (masaustu) ---
PC_AGENT_URL=http://192.168.1.186:8765
PC_AGENT_SECRET=              # pc-agent/config.json "secret" ile ayni
PC_HEARTBEAT_TIMEOUT_S=90     # bu sureden eski heartbeat = PC kapali

# --- DB ---
DATABASE_URL=sqlite:///./data/presence.db
HISTORY_RETENTION_DAYS=30

# --- Davranis ---
ABSENCE_DEBOUNCE_MIN=10
AUTO_WAKE_ENABLED=false       # once manuel test et, sonra ac
AUTO_WAKE_COOLDOWN_MIN=5
AUTO_SLEEP_ENABLED=false      # opt-in, varsayilan kapali
AUTO_SLEEP_AFTER_MIN=30

# --- Rate limit ---
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_PRESENCE=120/minute
